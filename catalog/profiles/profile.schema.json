{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "profile.schema.json",
  "title": "EMBED dataset profile module",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "profile_schema_version",
    "profile",
    "requires",
    "contributions",
    "sources",
    "contexts",
    "qualifications",
    "vocabularies",
    "profile_binding"
  ],
  "properties": {
    "$schema": {
      "const": "./profile.schema.json"
    },
    "profile_schema_version": {
      "const": 2
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "label": {
          "$ref": "#/$defs/nonblank_string"
        }
      }
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_schema_version"
      ],
      "properties": {
        "semantic_schema_version": {
          "const": 8
        }
      }
    },
    "contributions": {
      "$ref": "#/$defs/contributions"
    },
    "sources": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9_.-]*(?![\\s\\S])": {
          "$ref": "#/$defs/context_source"
        }
      },
      "additionalProperties": false
    },
    "contexts": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9_.-]*(?![\\s\\S])": {
          "$ref": "#/$defs/clinical_context"
        }
      },
      "additionalProperties": false
    },
    "qualifications": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9_.-]*(?![\\s\\S])": {
          "$ref": "#/$defs/qualification"
        }
      },
      "additionalProperties": false
    },
    "vocabularies": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9_.-]*(?![\\s\\S])": {
          "$ref": "#/$defs/vocabulary"
        }
      },
      "additionalProperties": false
    },
    "profile_binding": {
      "$ref": "#/$defs/profile_binding"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*(?![\\s\\S])"
    },
    "nonblank_string": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)[\\s\\S]*\\S(?![\\s\\S])"
    },
    "physical_name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?!.*\\s$)[^:]+$"
    },
    "claim_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*#[a-z][a-z0-9_.-]*(?![\\s\\S])"
    },
    "domain": {
      "enum": [
        "identity",
        "demographics",
        "social_determinants_of_health",
        "exam",
        "breast_side",
        "imaging",
        "mammography",
        "ultrasound",
        "mri",
        "pathology",
        "procedure",
        "report",
        "risk",
        "temporal",
        "workflow",
        "technical"
      ]
    },
    "evidence": {
      "enum": [
        "release_schema",
        "release_legend",
        "observed_source_values",
        "cross_table_check",
        "maintainer_confirmed",
        "inference",
        "unresolved"
      ]
    },
    "claim_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/claim_ref"
      }
    },
    "identifiers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "nonblank_strings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonblank_string"
      }
    },
    "domains_list": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/domain"
      }
    },
    "search_terms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonblank_string"
      }
    },
    "availability": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope"
          ],
          "properties": {
            "scope": {
              "const": "portable"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "profiles"
          ],
          "properties": {
            "scope": {
              "const": "profiles"
            },
            "profiles": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/identifier"
              }
            }
          }
        }
      ]
    },
    "contributions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clinical_objects",
        "concepts",
        "semantic_relationships",
        "temporal_semantics",
        "aggregations",
        "guardrails",
        "coverage"
      ],
      "properties": {
        "clinical_objects": {
          "$ref": "#/$defs/clinical_object_registry"
        },
        "concepts": {
          "$ref": "#/$defs/concept_registry"
        },
        "semantic_relationships": {
          "$ref": "#/$defs/semantic_relationship_registry"
        },
        "temporal_semantics": {
          "$ref": "#/$defs/temporal_semantic_registry"
        },
        "aggregations": {
          "$ref": "#/$defs/aggregation_registry"
        },
        "guardrails": {
          "$ref": "#/$defs/guardrail_registry"
        },
        "coverage": {
          "$ref": "#/$defs/coverage_registry"
        }
      }
    },
    "clinical_object_registry": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9_.-]*(?![\\s\\S])": {
          "$ref": "#/$defs/clinical_object"
        }
      },
      "additionalProperties": false
    },
    "concept_registry": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9_.-]*(?![\\s\\S])": {
          "$ref": "#/$defs/concept"
        }
      },
      "additionalProperties": false
    },
    "semantic_relationship_registry": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9_.-]*(?![\\s\\S])": {
          "$ref": "#/$defs/semantic_relationship"
        }
      },
      "additionalProperties": false
    },
    "temporal_semantic_registry": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9_.-]*(?![\\s\\S])": {
          "$ref": "#/$defs/temporal_semantic"
        }
      },
      "additionalProperties": false
    },
    "aggregation_registry": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9_.-]*(?![\\s\\S])": {
          "$ref": "#/$defs/aggregation"
        }
      },
      "additionalProperties": false
    },
    "guardrail_registry": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9_.-]*(?![\\s\\S])": {
          "$ref": "#/$defs/guardrail"
        }
      },
      "additionalProperties": false
    },
    "coverage_registry": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9_.-]*(?![\\s\\S])": {
          "$ref": "#/$defs/coverage"
        }
      },
      "additionalProperties": false
    },
    "clinical_object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "definition",
        "grain",
        "domains",
        "search_terms",
        "claim_refs",
        "caveats"
      ],
      "properties": {
        "availability": {
          "$ref": "#/$defs/availability"
        },
        "label": {
          "$ref": "#/$defs/nonblank_string"
        },
        "definition": {
          "$ref": "#/$defs/nonblank_string"
        },
        "grain": {
          "$ref": "#/$defs/nonblank_string"
        },
        "domains": {
          "$ref": "#/$defs/domains_list"
        },
        "search_terms": {
          "$ref": "#/$defs/search_terms"
        },
        "claim_refs": {
          "$ref": "#/$defs/claim_refs"
        },
        "caveats": {
          "$ref": "#/$defs/nonblank_strings"
        }
      }
    },
    "missing_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "representation",
        "meaning",
        "claim_refs",
        "caveats"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "representation": {
          "$ref": "#/$defs/nonblank_string"
        },
        "meaning": {
          "$ref": "#/$defs/nonblank_string"
        },
        "claim_refs": {
          "$ref": "#/$defs/claim_refs"
        },
        "caveats": {
          "$ref": "#/$defs/nonblank_strings"
        }
      }
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "definition",
        "feature_kind",
        "domains",
        "search_terms",
        "caveats",
        "evidence",
        "objects"
      ],
      "properties": {
        "availability": {
          "$ref": "#/$defs/availability"
        },
        "label": {
          "$ref": "#/$defs/nonblank_string"
        },
        "definition": {
          "$ref": "#/$defs/nonblank_string"
        },
        "feature_kind": {
          "enum": [
            "identifier",
            "date",
            "categorical",
            "coded",
            "flag",
            "numeric",
            "text",
            "aggregate",
            "model_output",
            "technical"
          ]
        },
        "domains": {
          "$ref": "#/$defs/domains_list"
        },
        "search_terms": {
          "$ref": "#/$defs/search_terms"
        },
        "caveats": {
          "$ref": "#/$defs/nonblank_strings"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "objects": {
          "$ref": "#/$defs/identifiers"
        },
        "vocabulary": {
          "$ref": "#/$defs/identifier"
        },
        "claim_refs": {
          "$ref": "#/$defs/claim_refs"
        },
        "missing_states": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/missing_state"
          }
        },
        "temporal_semantics": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "aggregations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "feature_kind": {
                "const": "technical"
              }
            },
            "required": [
              "feature_kind"
            ]
          },
          "else": {
            "properties": {
              "objects": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "cardinality_value": {
      "enum": [
        "exactly_one",
        "zero_or_one",
        "one_or_more",
        "zero_or_more",
        "unknown"
      ]
    },
    "cardinality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targets_per_source",
        "sources_per_target"
      ],
      "properties": {
        "targets_per_source": {
          "$ref": "#/$defs/cardinality_value"
        },
        "sources_per_target": {
          "$ref": "#/$defs/cardinality_value"
        }
      }
    },
    "optionality_value": {
      "enum": [
        "required",
        "optional",
        "unknown"
      ]
    },
    "semantic_optionality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "target"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/optionality_value"
        },
        "target": {
          "$ref": "#/$defs/optionality_value"
        }
      }
    },
    "semantic_relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "kind",
        "source_object",
        "target_object",
        "cardinality",
        "optionality",
        "attribution",
        "attribution_limitations",
        "temporal_qualification",
        "temporal_semantics",
        "domains",
        "search_terms",
        "claim_refs",
        "caveats"
      ],
      "properties": {
        "availability": {
          "$ref": "#/$defs/availability"
        },
        "label": {
          "$ref": "#/$defs/nonblank_string"
        },
        "kind": {
          "enum": [
            "hierarchy",
            "association",
            "attribution",
            "documentation",
            "derivation"
          ]
        },
        "source_object": {
          "$ref": "#/$defs/identifier"
        },
        "target_object": {
          "$ref": "#/$defs/identifier"
        },
        "cardinality": {
          "$ref": "#/$defs/cardinality"
        },
        "optionality": {
          "$ref": "#/$defs/semantic_optionality"
        },
        "attribution": {
          "$ref": "#/$defs/nonblank_string"
        },
        "attribution_limitations": {
          "$ref": "#/$defs/nonblank_strings"
        },
        "temporal_qualification": {
          "$ref": "#/$defs/nonblank_string"
        },
        "temporal_semantics": {
          "$ref": "#/$defs/identifiers"
        },
        "domains": {
          "$ref": "#/$defs/domains_list"
        },
        "search_terms": {
          "$ref": "#/$defs/search_terms"
        },
        "claim_refs": {
          "$ref": "#/$defs/claim_refs"
        },
        "caveats": {
          "$ref": "#/$defs/nonblank_strings"
        }
      }
    },
    "temporal_semantic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "kind",
        "meaning",
        "objects",
        "feature_refs",
        "relative_to",
        "domains",
        "search_terms",
        "claim_refs",
        "caveats"
      ],
      "properties": {
        "availability": {
          "$ref": "#/$defs/availability"
        },
        "label": {
          "$ref": "#/$defs/nonblank_string"
        },
        "kind": {
          "enum": [
            "event_time",
            "documentation_time",
            "availability_time"
          ]
        },
        "meaning": {
          "$ref": "#/$defs/nonblank_string"
        },
        "objects": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "feature_refs": {
          "$ref": "#/$defs/identifiers"
        },
        "relative_to": {
          "description": "Reference time semantics that this time is generally downstream of in the represented clinical context; membership does not assert universal ordering, causality, certainty, or a required interval.",
          "$ref": "#/$defs/identifiers"
        },
        "domains": {
          "$ref": "#/$defs/domains_list"
        },
        "search_terms": {
          "$ref": "#/$defs/search_terms"
        },
        "claim_refs": {
          "$ref": "#/$defs/claim_refs"
        },
        "caveats": {
          "$ref": "#/$defs/nonblank_strings"
        }
      }
    },
    "aggregation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "status",
        "source_object",
        "target_object",
        "source_concept",
        "result_concept",
        "semantic_relationships",
        "method",
        "ordering",
        "domains",
        "search_terms",
        "claim_refs",
        "caveats"
      ],
      "properties": {
        "availability": {
          "$ref": "#/$defs/availability"
        },
        "label": {
          "$ref": "#/$defs/nonblank_string"
        },
        "status": {
          "enum": [
            "provided",
            "analyst_defined",
            "unsupported",
            "unresolved"
          ]
        },
        "source_object": {
          "$ref": "#/$defs/identifier"
        },
        "target_object": {
          "$ref": "#/$defs/identifier"
        },
        "source_concept": {
          "$ref": "#/$defs/identifier"
        },
        "result_concept": {
          "oneOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "semantic_relationships": {
          "$ref": "#/$defs/identifiers"
        },
        "method": {
          "$ref": "#/$defs/nonblank_string"
        },
        "ordering": {
          "$ref": "#/$defs/nonblank_string"
        },
        "domains": {
          "$ref": "#/$defs/domains_list"
        },
        "search_terms": {
          "$ref": "#/$defs/search_terms"
        },
        "claim_refs": {
          "$ref": "#/$defs/claim_refs"
        },
        "caveats": {
          "$ref": "#/$defs/nonblank_strings"
        }
      }
    },
    "scope_profiles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "guardrail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "statement",
        "rationale",
        "category",
        "priority",
        "scope",
        "profiles",
        "objects",
        "concepts",
        "semantic_relationships",
        "temporal_semantics",
        "aggregations",
        "coverage",
        "domains",
        "search_terms",
        "claim_refs",
        "caveats"
      ],
      "properties": {
        "availability": {
          "$ref": "#/$defs/availability"
        },
        "title": {
          "$ref": "#/$defs/nonblank_string"
        },
        "statement": {
          "$ref": "#/$defs/nonblank_string"
        },
        "rationale": {
          "$ref": "#/$defs/nonblank_string"
        },
        "category": {
          "enum": [
            "prohibition",
            "analyst_choice",
            "interpretation_limit"
          ]
        },
        "priority": {
          "enum": [
            "critical",
            "high",
            "standard"
          ]
        },
        "scope": {
          "enum": [
            "general_clinical",
            "embed_general",
            "profile_specific"
          ]
        },
        "profiles": {
          "$ref": "#/$defs/scope_profiles"
        },
        "objects": {
          "$ref": "#/$defs/identifiers"
        },
        "concepts": {
          "$ref": "#/$defs/identifiers"
        },
        "semantic_relationships": {
          "$ref": "#/$defs/identifiers"
        },
        "temporal_semantics": {
          "$ref": "#/$defs/identifiers"
        },
        "aggregations": {
          "$ref": "#/$defs/identifiers"
        },
        "coverage": {
          "$ref": "#/$defs/identifiers"
        },
        "domains": {
          "$ref": "#/$defs/domains_list"
        },
        "search_terms": {
          "$ref": "#/$defs/search_terms"
        },
        "claim_refs": {
          "$ref": "#/$defs/claim_refs"
        },
        "caveats": {
          "$ref": "#/$defs/nonblank_strings"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/profile_scope_rule"
        }
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_kind",
        "subject",
        "status",
        "scope",
        "profiles",
        "summary",
        "domains",
        "search_terms",
        "claim_refs",
        "caveats"
      ],
      "properties": {
        "availability": {
          "$ref": "#/$defs/availability"
        },
        "subject_kind": {
          "enum": [
            "clinical_object",
            "concept",
            "semantic_relationship",
            "temporal_semantic",
            "aggregation",
            "guardrail",
            "topic"
          ]
        },
        "subject": {
          "$ref": "#/$defs/identifier"
        },
        "status": {
          "enum": [
            "supported",
            "unsupported",
            "unresolved",
            "not_cataloged"
          ]
        },
        "scope": {
          "enum": [
            "general_clinical",
            "embed_general",
            "profile_specific"
          ]
        },
        "profiles": {
          "$ref": "#/$defs/scope_profiles"
        },
        "summary": {
          "$ref": "#/$defs/nonblank_string"
        },
        "domains": {
          "$ref": "#/$defs/domains_list"
        },
        "search_terms": {
          "$ref": "#/$defs/search_terms"
        },
        "claim_refs": {
          "$ref": "#/$defs/claim_refs"
        },
        "caveats": {
          "$ref": "#/$defs/nonblank_strings"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/profile_scope_rule"
        }
      ]
    },
    "profile_scope_rule": {
      "if": {
        "properties": {
          "scope": {
            "const": "profile_specific"
          }
        },
        "required": [
          "scope"
        ]
      },
      "then": {
        "properties": {
          "profiles": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "profiles": {
            "maxItems": 0
          }
        }
      }
    },
    "vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "completeness",
        "parsing",
        "evidence",
        "codes"
      ],
      "properties": {
        "availability": {
          "$ref": "#/$defs/availability"
        },
        "label": {
          "$ref": "#/$defs/nonblank_string"
        },
        "completeness": {
          "enum": [
            "unknown",
            "open",
            "closed"
          ]
        },
        "parsing": {
          "enum": [
            "atomic",
            "comma_composed_undocumented",
            "comma_delimited_unordered",
            "shared_slot_dictionary"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "caveats": {
          "$ref": "#/$defs/nonblank_strings"
        },
        "codes": {
          "type": "object",
          "minProperties": 1,
          "patternProperties": {
            "^(?!\\s)(?!.*\\s$).+$": {
