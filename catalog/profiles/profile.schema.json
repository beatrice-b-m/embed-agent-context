    "context_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "kind",
        "scope",
        "locator_kind",
        "locator",
        "version_scope",
        "profiles",
        "notes"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/nonblank_string"
        },
        "kind": {
          "enum": [
            "maintainer_confirmed",
            "release_schema",
            "release_legend",
            "supporting_internal",
            "public_documentation"
          ]
        },
        "scope": {
          "enum": [
            "general_clinical",
            "embed_general",
            "profile_specific"
          ]
        },
        "locator_kind": {
          "enum": [
            "url",
            "repository_path",
            "logical_artifact"
          ]
        },
        "locator": {
          "$ref": "#/$defs/nonblank_string"
        },
        "version_scope": {
          "$ref": "#/$defs/nonblank_string"
        },
        "profiles": {
          "$ref": "#/$defs/scope_profiles"
        },
        "notes": {
          "$ref": "#/$defs/nonblank_strings"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "release_schema",
                  "release_legend"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "profiles": {
                "minItems": 1
              }
            }
          }
        },
        {
          "$ref": "#/$defs/profile_scope_rule"
        },
        {
          "if": {
            "properties": {
              "locator_kind": {
                "const": "url"
              }
            },
            "required": [
              "locator_kind"
            ]
          },
          "then": {
            "properties": {
              "locator": {
                "pattern": "^https://"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "locator_kind": {
                "const": "repository_path"
              }
            },
            "required": [
              "locator_kind"
            ]
          },
          "then": {
            "properties": {
              "locator": {
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
              }
            }
          }
        }
      ]
