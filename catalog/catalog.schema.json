{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catalog.schema.json",
  "title": "EMBED count-free clinical-semantic context catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "profiles",
    "binding_grains",
    "feature_kinds",
    "domains",
    "context_kinds",
    "context_scopes",
    "source_kinds",
    "source_locator_kinds",
    "claim_statuses",
    "semantic_relationship_kinds",
    "temporal_kinds",
    "aggregation_statuses",
    "coverage_statuses",
    "clinical_objects",
    "concepts",
    "semantic_relationships",
    "temporal_semantics",
    "aggregations",
    "guardrails",
    "coverage",
    "vocabularies",
    "sources",
    "contexts",
    "profile_bindings"
  ],
  "properties": {
    "$schema": {
      "const": "./catalog.schema.json"
    },
    "schema_version": {
      "const": 5
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "binding_grains": {
      "const": [
        "patient",
        "exam",
        "breast_side",
        "imaging_finding",
        "pathology_finding",
        "report",
        "risk_assessment",
        "wide_row"
      ]
    },
    "feature_kinds": {
      "const": [
        "identifier",
        "date",
        "categorical",
        "coded",
        "flag",
        "numeric",
        "text",
        "aggregate",
        "model_output",
        "technical"
      ]
    },
    "domains": {
      "const": [
        "identity",
        "demographics",
        "social_determinants_of_health",
        "exam",
        "breast_side",
        "imaging",
        "mammography",
        "ultrasound",
        "mri",
        "pathology",
        "procedure",
        "report",
        "risk",
        "temporal",
        "workflow",
        "technical"
      ]
    },
    "context_kinds": {
      "const": [
        "clinical_workflow",
        "data_representation",
        "interpretation_guardrail",
        "known_issue"
      ]
    },
    "context_scopes": {
      "const": [
        "general_clinical",
        "embed_general",
        "profile_specific"
      ]
    },
    "source_kinds": {
      "const": [
        "maintainer_confirmed",
        "release_schema",
        "release_legend",
        "supporting_internal",
        "public_documentation"
      ]
    },
    "source_locator_kinds": {
      "const": [
        "url",
        "repository_path",
        "logical_artifact"
      ]
    },
    "claim_statuses": {
      "const": [
        "verified",
        "reconciled",
        "unverified",
        "unresolved",
        "contradicted"
      ]
    },
    "semantic_relationship_kinds": {
      "const": [
        "hierarchy",
        "association",
        "attribution",
        "documentation",
        "derivation"
      ]
    },
    "temporal_kinds": {
      "const": [
        "event_time",
        "documentation_time",
        "availability_time"
      ]
    },
    "aggregation_statuses": {
      "const": [
        "provided",
        "analyst_defined",
        "unsupported",
        "unresolved"
      ]
    },
    "coverage_statuses": {
      "const": [
        "supported",
        "unsupported",
        "unresolved",
        "not_cataloged"
      ]
    },
    "clinical_objects": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[a-z][a-z0-9_.-]*(?![\\s\\S])": {
          "$ref": "#/$defs/clinical_object"
        }
      },
      "additionalProperties": false
    },
    "concepts": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[a-z][a-z0-9_.-]*(?![\\s\\S])": {
          "$ref": "#/$defs/concept"
        }
      },
      "additionalProperties": false
    },
    "semantic_relationships": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[a-z][a-z0-9_.-]*(?![\\s\\S])": {
          "$ref": "#/$defs/semantic_relationship"
        }
      },
      "additionalProperties": false
    },
    "temporal_semantics": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[a-z][a-z0-9_.-]*(?![\\s\\S])": {
          "$ref": "#/$defs/temporal_semantic"
        }
      },
      "additionalProperties": false
    },
    "aggregations": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[a-z][a-z0-9_.-]*(?![\\s\\S])": {
          "$ref": "#/$defs/aggregation"
        }
      },
      "additionalProperties": false
    },
    "guardrails": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[a-z][a-z0-9_.-]*(?![\\s\\S])": {
          "$ref": "#/$defs/guardrail"
        }
      },
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[a-z][a-z0-9_.-]*(?![\\s\\S])": {
          "$ref": "#/$defs/coverage"
        }
      },
      "additionalProperties": false
    },
    "vocabularies": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9_.-]*(?![\\s\\S])": {
          "$ref": "#/$defs/vocabulary"
        }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9_.-]*(?![\\s\\S])": {
          "$ref": "#/$defs/context_source"
        }
      },
      "additionalProperties": false
    },
    "contexts": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9_.-]*(?![\\s\\S])": {
          "$ref": "#/$defs/clinical_context"
        }
      },
      "additionalProperties": false
    },
    "profile_bindings": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[a-z][a-z0-9_.-]*(?![\\s\\S])": {
          "$ref": "#/$defs/profile_binding"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*(?![\\s\\S])"
    },
    "nonblank_string": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "physical_name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?!.*\\s$)[^:]+$"
    },
    "claim_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*#[a-z][a-z0-9_.-]*(?![\\s\\S])"
    },
    "domain": {
      "enum": [
        "identity",
        "demographics",
        "social_determinants_of_health",
        "exam",
        "breast_side",
        "imaging",
        "mammography",
        "ultrasound",
        "mri",
        "pathology",
        "procedure",
        "report",
        "risk",
        "temporal",
        "workflow",
        "technical"
      ]
    },
    "binding_grain": {
      "enum": [
        "patient",
        "exam",
        "breast_side",
        "imaging_finding",
        "pathology_finding",
        "report",
        "risk_assessment",
        "wide_row"
      ]
    },
    "evidence": {
      "enum": [
        "release_schema",
        "release_legend",
        "observed_v2_values",
        "cross_table_check",
        "maintainer_confirmed",
        "inference",
        "unresolved"
      ]
    },
    "claim_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/claim_ref"
      }
    },
    "identifiers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "nonblank_strings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonblank_string"
      }
    },
    "domains_list": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/domain"
      }
    },
    "search_terms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonblank_string"
      }
    },
    "clinical_object": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "definition",
        "grain",
        "domains",
        "search_terms",
        "claim_refs",
        "caveats"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/nonblank_string"
        },
        "definition": {
          "$ref": "#/$defs/nonblank_string"
        },
        "grain": {
          "$ref": "#/$defs/nonblank_string"
        },
        "domains": {
          "$ref": "#/$defs/domains_list"
        },
        "search_terms": {
          "$ref": "#/$defs/search_terms"
        },
        "claim_refs": {
          "$ref": "#/$defs/claim_refs"
        },
        "caveats": {
          "$ref": "#/$defs/nonblank_strings"
        }
      }
    },
    "missing_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "representation",
        "meaning",
        "claim_refs",
        "caveats"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "representation": {
          "$ref": "#/$defs/nonblank_string"
        },
        "meaning": {
          "$ref": "#/$defs/nonblank_string"
        },
        "claim_refs": {
          "$ref": "#/$defs/claim_refs"
        },
        "caveats": {
          "$ref": "#/$defs/nonblank_strings"
        }
      }
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "definition",
        "feature_kind",
        "domains",
        "search_terms",
        "caveats",
        "evidence",
        "objects"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/nonblank_string"
        },
        "definition": {
          "$ref": "#/$defs/nonblank_string"
        },
        "feature_kind": {
          "enum": [
            "identifier",
            "date",
            "categorical",
            "coded",
            "flag",
            "numeric",
            "text",
            "aggregate",
            "model_output",
            "technical"
          ]
        },
        "domains": {
          "$ref": "#/$defs/domains_list"
        },
        "search_terms": {
          "$ref": "#/$defs/search_terms"
        },
        "caveats": {
          "$ref": "#/$defs/nonblank_strings"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "objects": {
          "$ref": "#/$defs/identifiers"
        },
        "vocabulary": {
          "$ref": "#/$defs/identifier"
        },
        "claim_refs": {
          "$ref": "#/$defs/claim_refs"
        },
        "missing_states": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/missing_state"
          }
        },
        "temporal_semantics": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "aggregations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "feature_kind": {
                "const": "technical"
              }
            },
            "required": [
              "feature_kind"
            ]
          },
          "else": {
            "properties": {
              "objects": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "cardinality_value": {
      "enum": [
        "exactly_one",
        "zero_or_one",
        "one_or_more",
        "zero_or_more",
        "unknown"
      ]
    },
    "cardinality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targets_per_source",
        "sources_per_target"
      ],
      "properties": {
        "targets_per_source": {
          "$ref": "#/$defs/cardinality_value"
        },
        "sources_per_target": {
          "$ref": "#/$defs/cardinality_value"
        }
      }
    },
    "optionality_value": {
      "enum": [
        "required",
        "optional",
        "unknown"
      ]
    },
    "semantic_optionality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "target"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/optionality_value"
        },
        "target": {
          "$ref": "#/$defs/optionality_value"
        }
      }
    },
    "semantic_relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "kind",
        "source_object",
        "target_object",
        "cardinality",
        "optionality",
        "attribution",
        "attribution_limitations",
        "temporal_qualification",
        "temporal_semantics",
        "domains",
        "search_terms",
        "claim_refs",
        "caveats"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/nonblank_string"
        },
        "kind": {
          "enum": [
            "hierarchy",
            "association",
            "attribution",
            "documentation",
            "derivation"
          ]
        },
        "source_object": {
          "$ref": "#/$defs/identifier"
        },
        "target_object": {
          "$ref": "#/$defs/identifier"
        },
        "cardinality": {
          "$ref": "#/$defs/cardinality"
        },
        "optionality": {
          "$ref": "#/$defs/semantic_optionality"
        },
        "attribution": {
          "$ref": "#/$defs/nonblank_string"
        },
        "attribution_limitations": {
          "$ref": "#/$defs/nonblank_strings"
        },
        "temporal_qualification": {
          "$ref": "#/$defs/nonblank_string"
        },
        "temporal_semantics": {
          "$ref": "#/$defs/identifiers"
        },
        "domains": {
          "$ref": "#/$defs/domains_list"
        },
        "search_terms": {
          "$ref": "#/$defs/search_terms"
        },
        "claim_refs": {
          "$ref": "#/$defs/claim_refs"
        },
        "caveats": {
          "$ref": "#/$defs/nonblank_strings"
        }
      }
    },
    "temporal_semantic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "kind",
        "meaning",
        "objects",
        "feature_refs",
        "relative_to",
        "domains",
        "search_terms",
        "claim_refs",
        "caveats"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/nonblank_string"
        },
        "kind": {
          "enum": [
            "event_time",
            "documentation_time",
            "availability_time"
          ]
        },
        "meaning": {
          "$ref": "#/$defs/nonblank_string"
        },
        "objects": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "feature_refs": {
          "$ref": "#/$defs/identifiers"
        },
        "relative_to": {
          "description": "Reference time semantics that this time is generally downstream of in the represented clinical context; membership does not assert universal ordering, causality, certainty, or a required interval.",
          "$ref": "#/$defs/identifiers"
        },
        "domains": {
          "$ref": "#/$defs/domains_list"
        },
        "search_terms": {
          "$ref": "#/$defs/search_terms"
        },
        "claim_refs": {
          "$ref": "#/$defs/claim_refs"
        },
        "caveats": {
          "$ref": "#/$defs/nonblank_strings"
        }
      }
    },
    "aggregation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "status",
        "source_object",
        "target_object",
        "source_concept",
        "result_concept",
        "semantic_relationships",
        "method",
        "ordering",
        "domains",
        "search_terms",
        "claim_refs",
        "caveats"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/nonblank_string"
        },
        "status": {
          "enum": [
            "provided",
            "analyst_defined",
            "unsupported",
            "unresolved"
          ]
        },
        "source_object": {
          "$ref": "#/$defs/identifier"
        },
        "target_object": {
          "$ref": "#/$defs/identifier"
        },
        "source_concept": {
          "$ref": "#/$defs/identifier"
        },
        "result_concept": {
          "oneOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "semantic_relationships": {
          "$ref": "#/$defs/identifiers"
        },
        "method": {
          "$ref": "#/$defs/nonblank_string"
        },
        "ordering": {
          "$ref": "#/$defs/nonblank_string"
        },
        "domains": {
          "$ref": "#/$defs/domains_list"
        },
        "search_terms": {
          "$ref": "#/$defs/search_terms"
        },
        "claim_refs": {
          "$ref": "#/$defs/claim_refs"
        },
        "caveats": {
          "$ref": "#/$defs/nonblank_strings"
        }
      }
    },
    "scope_profiles": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "guardrail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "statement",
        "rationale",
        "scope",
        "profiles",
        "objects",
        "concepts",
        "semantic_relationships",
        "temporal_semantics",
        "aggregations",
        "coverage",
        "domains",
        "search_terms",
        "claim_refs",
        "caveats"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/nonblank_string"
        },
        "statement": {
          "$ref": "#/$defs/nonblank_string"
        },
        "rationale": {
          "$ref": "#/$defs/nonblank_string"
        },
        "scope": {
          "enum": [
            "general_clinical",
            "embed_general",
            "profile_specific"
          ]
        },
        "profiles": {
          "$ref": "#/$defs/scope_profiles"
        },
        "objects": {
          "$ref": "#/$defs/identifiers"
        },
        "concepts": {
          "$ref": "#/$defs/identifiers"
        },
        "semantic_relationships": {
          "$ref": "#/$defs/identifiers"
        },
        "temporal_semantics": {
          "$ref": "#/$defs/identifiers"
        },
        "aggregations": {
          "$ref": "#/$defs/identifiers"
        },
        "coverage": {
          "$ref": "#/$defs/identifiers"
        },
        "domains": {
          "$ref": "#/$defs/domains_list"
        },
        "search_terms": {
          "$ref": "#/$defs/search_terms"
        },
        "claim_refs": {
          "$ref": "#/$defs/claim_refs"
        },
        "caveats": {
          "$ref": "#/$defs/nonblank_strings"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/profile_scope_rule"
        }
      ]
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_kind",
        "subject",
        "status",
        "scope",
        "profiles",
        "summary",
        "domains",
        "search_terms",
        "claim_refs",
        "caveats"
      ],
      "properties": {
        "subject_kind": {
          "enum": [
            "clinical_object",
            "concept",
            "semantic_relationship",
            "temporal_semantic",
            "aggregation",
            "guardrail",
            "topic"
          ]
        },
        "subject": {
          "$ref": "#/$defs/identifier"
        },
        "status": {
          "enum": [
            "supported",
            "unsupported",
            "unresolved",
            "not_cataloged"
          ]
        },
        "scope": {
          "enum": [
            "general_clinical",
            "embed_general",
            "profile_specific"
          ]
        },
        "profiles": {
          "$ref": "#/$defs/scope_profiles"
        },
        "summary": {
          "$ref": "#/$defs/nonblank_string"
        },
        "domains": {
          "$ref": "#/$defs/domains_list"
        },
        "search_terms": {
          "$ref": "#/$defs/search_terms"
        },
        "claim_refs": {
          "$ref": "#/$defs/claim_refs"
        },
        "caveats": {
          "$ref": "#/$defs/nonblank_strings"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/profile_scope_rule"
        }
      ]
    },
    "profile_scope_rule": {
      "if": {
        "properties": {
          "scope": {
            "const": "profile_specific"
          }
        },
        "required": [
          "scope"
        ]
      },
      "then": {
        "properties": {
          "profiles": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "profiles": {
            "maxItems": 0
          }
        }
      }
    },
    "vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "completeness",
        "parsing",
        "evidence",
        "codes"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/nonblank_string"
        },
        "completeness": {
          "enum": [
            "unknown",
            "open",
            "closed"
          ]
        },
        "parsing": {
          "enum": [
            "atomic",
            "comma_composed_undocumented",
            "shared_slot_dictionary"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "caveats": {
          "$ref": "#/$defs/nonblank_strings"
        },
        "codes": {
          "type": "object",
          "minProperties": 1,
          "patternProperties": {
            "^(?!\\s)(?!.*\\s$).+$": {
              "$ref": "#/$defs/nonblank_string"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "context_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "kind",
        "scope",
        "locator_kind",
        "locator",
        "version_scope",
        "profiles",
        "notes"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/nonblank_string"
        },
        "kind": {
          "enum": [
            "maintainer_confirmed",
            "release_schema",
            "release_legend",
            "supporting_internal",
            "public_documentation"
          ]
        },
        "scope": {
          "enum": [
            "general_clinical",
            "embed_general",
            "profile_specific"
          ]
        },
        "locator_kind": {
          "enum": [
            "url",
            "repository_path",
            "logical_artifact"
          ]
        },
        "locator": {
          "$ref": "#/$defs/nonblank_string"
        },
        "version_scope": {
          "$ref": "#/$defs/nonblank_string"
        },
        "profiles": {
          "$ref": "#/$defs/scope_profiles"
        },
        "notes": {
          "$ref": "#/$defs/nonblank_strings"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "release_schema",
                  "release_legend"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "profiles": {
                "minItems": 1
              }
            }
          }
        },
        {
          "$ref": "#/$defs/profile_scope_rule"
        },
        {
          "if": {
            "properties": {
              "locator_kind": {
                "const": "url"
              }
            },
            "required": [
              "locator_kind"
            ]
          },
          "then": {
            "properties": {
              "locator": {
                "pattern": "^https://"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "locator_kind": {
                "const": "repository_path"
              }
            },
            "required": [
              "locator_kind"
            ]
          },
          "then": {
            "properties": {
              "locator": {
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
              }
            }
          }
        }
      ]
    },
