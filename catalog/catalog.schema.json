{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catalog.schema.json",
  "title": "EMBED V2 count-free feature and clinical context catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "profiles",
    "grains",
    "feature_kinds",
    "domains",
    "context_kinds",
    "context_scopes",
    "source_kinds",
    "source_locator_kinds",
    "claim_statuses",
    "concepts",
    "bindings",
    "vocabularies",
    "tables",
    "relationships",
    "sources",
    "contexts"
  ],
  "properties": {
    "$schema": {
      "const": "./catalog.schema.json"
    },
    "schema_version": {
      "const": 3
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]*$"
      }
    },
    "grains": {
      "const": [
        "patient",
        "exam",
        "breast_side",
        "imaging_finding",
        "pathology_finding",
        "report",
        "risk_assessment",
        "wide_row"
      ]
    },
    "feature_kinds": {
      "const": [
        "identifier",
        "date",
        "categorical",
        "coded",
        "flag",
        "numeric",
        "text",
        "aggregate",
        "model_output",
        "technical"
      ]
    },
    "domains": {
      "const": [
        "identity",
        "demographics",
        "social_determinants_of_health",
        "exam",
        "breast_side",
        "imaging",
        "mammography",
        "ultrasound",
        "mri",
        "pathology",
        "procedure",
        "report",
        "risk",
        "temporal",
        "workflow",
        "technical"
      ]
    },
    "context_kinds": {
      "const": [
        "clinical_workflow",
        "data_representation",
        "interpretation_guardrail",
        "known_issue"
      ]
    },
    "context_scopes": {
      "const": [
        "general_clinical",
        "embed_general",
        "profile_specific"
      ]
    },
    "source_kinds": {
      "const": [
        "maintainer_confirmed",
        "release_schema",
        "release_legend",
        "supporting_internal",
        "public_documentation"
      ]
    },
    "source_locator_kinds": {
      "const": [
        "url",
        "repository_path",
        "logical_artifact"
      ]
    },
    "claim_statuses": {
      "const": [
        "verified",
        "reconciled",
        "unverified",
        "unresolved",
        "contradicted"
      ]
    },
    "concepts": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[a-z][a-z0-9_.-]*$": {
          "$ref": "#/$defs/concept"
        }
      },
      "additionalProperties": false
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/binding"
      }
    },
    "vocabularies": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9_.-]*$": {
          "$ref": "#/$defs/vocabulary"
        }
      },
      "additionalProperties": false
    },
    "tables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/table"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "sources": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9_.-]*$": {
          "$ref": "#/$defs/context_source"
        }
      },
      "additionalProperties": false
    },
    "contexts": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9_.-]*$": {
          "$ref": "#/$defs/clinical_context"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "evidence": {
      "type": "string",
      "enum": [
        "release_schema",
        "release_legend",
        "observed_v2_values",
        "cross_table_check",
        "maintainer_confirmed",
        "inference",
        "unresolved"
      ]
    },
    "context_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "kind",
        "scope",
        "locator_kind",
        "locator",
        "version_scope",
        "profiles",
        "notes"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "kind": {
          "enum": [
            "maintainer_confirmed",
            "release_schema",
            "release_legend",
            "supporting_internal",
            "public_documentation"
          ]
        },
        "scope": {
          "enum": [
            "general_clinical",
            "embed_general",
            "profile_specific"
          ]
        },
        "locator_kind": {
          "enum": [
            "url",
            "repository_path",
            "logical_artifact"
          ]
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "version_scope": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "profiles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*(?![\\s\\S])"
          }
        },
        "notes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "release_schema",
                  "release_legend"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "profiles": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "scope": {
                "const": "profile_specific"
              }
            },
            "required": [
              "scope"
            ]
          },
          "then": {
            "properties": {
              "profiles": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "profiles": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "locator_kind": {
                "const": "url"
              }
            },
            "required": [
              "locator_kind"
            ]
          },
          "then": {
            "properties": {
              "locator": {
                "pattern": "^https://"
              }
            }
          }
        }
      ]
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "definition",
        "feature_kind",
        "domains",
        "search_terms",
        "caveats",
        "evidence"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "feature_kind": {
          "enum": [
            "identifier",
            "date",
            "categorical",
            "coded",
            "flag",
            "numeric",
            "text",
            "aggregate",
            "model_output",
            "technical"
          ]
        },
        "domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "identity",
              "demographics",
              "social_determinants_of_health",
              "exam",
              "breast_side",
              "imaging",
              "mammography",
              "ultrasound",
              "mri",
              "pathology",
              "procedure",
              "report",
              "risk",
              "temporal",
              "workflow",
              "technical"
            ]
          }
        },
        "search_terms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "caveats": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "vocabulary": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "table",
        "column",
        "concept",
        "grain",
        "role",
        "physical_type",
        "nullable"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "table": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!\\s)(?!.*\\s$)[^:]+$"
        },
        "column": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!\\s)(?!.*\\s$)[^:]+$"
        },
        "concept": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "grain": {
          "enum": [
            "patient",
            "exam",
            "breast_side",
            "imaging_finding",
            "pathology_finding",
            "report",
            "risk_assessment",
            "wide_row"
          ]
        },
        "role": {
          "enum": [
            "canonical",
            "reference",
            "wide_projection",
            "technical"
          ]
        },
        "physical_type": {
          "type": "string",
          "minLength": 1
        },
        "nullable": {
          "type": "boolean"
        },
        "parameters": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "slot": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "notes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "completeness",
        "parsing",
        "evidence",
        "codes"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "completeness": {
          "enum": [
            "unknown",
            "open",
            "closed"
          ]
        },
        "parsing": {
          "enum": [
            "atomic",
            "comma_composed_undocumented",
            "shared_slot_dictionary"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "caveats": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "codes": {
          "type": "object",
          "minProperties": 1,
          "patternProperties": {
            "^.+$": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      }
    },
    "key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "columns",
        "kind",
        "uniqueness",
        "completeness",
        "evidence",
        "caveats"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*(?![\\s\\S])"
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!\\s)(?!.*\\s$)[^:]+$"
          }
        },
        "kind": {
          "enum": [
            "natural",
            "technical"
          ]
        },
        "uniqueness": {
          "enum": [
            "unique",
            "not_unique",
            "unknown"
          ]
        },
        "completeness": {
          "enum": [
            "complete",
            "incomplete",
            "unknown"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "caveats": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "table",
        "grain",
        "keys",
        "caveats"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*(?![\\s\\S])"
        },
        "table": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!\\s)(?!.*\\s$)[^:]+$"
        },
        "grain": {
          "enum": [
            "patient",
            "exam",
            "breast_side",
            "imaging_finding",
            "pathology_finding",
            "report",
            "risk_assessment",
            "wide_row"
          ]
        },
        "keys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/key"
          }
        },
        "caveats": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "source_endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "table",
        "columns",
        "completeness"
      ],
      "properties": {
        "table": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!\\s)(?!.*\\s$)[^:]+$"
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!\\s)(?!.*\\s$)[^:]+$"
          }
        },
        "completeness": {
          "enum": [
            "required",
            "optional",
            "unknown"
          ]
        }
      }
    },
    "target_endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "table",
        "columns"
      ],
      "properties": {
        "table": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!\\s)(?!.*\\s$)[^:]+$"
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!\\s)(?!.*\\s$)[^:]+$"
          }
        }
      }
    },
    "cardinality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targets_per_source",
        "sources_per_target"
      ],
      "properties": {
        "targets_per_source": {
          "$ref": "#/$defs/cardinality_value"
        },
        "sources_per_target": {
          "$ref": "#/$defs/cardinality_value"
        }
      }
    },
    "cardinality_value": {
      "enum": [
        "exactly_one",
        "zero_or_one",
        "one_or_more",
        "zero_or_more",
        "unknown"
      ]
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "profile",
        "kind",
        "source",
        "target",
        "cardinality",
        "evidence",
        "caveats",
        "join_hazards"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*(?![\\s\\S])"
        },
        "profile": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*(?![\\s\\S])"
        },
        "kind": {
          "enum": [
            "hierarchy",
            "reference",
            "projection"
          ]
        },
        "source": {
          "$ref": "#/$defs/source_endpoint"
        },
        "target": {
          "$ref": "#/$defs/target_endpoint"
        },
        "cardinality": {
          "$ref": "#/$defs/cardinality"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "caveats": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "join_hazards": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "context_table_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "table"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*(?![\\s\\S])"
        },
        "table": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!\\s)(?!.*\\s$)[^:]+$"
        }
      }
    },
    "context_claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "status",
        "sources",
        "caveats"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*(?![\\s\\S])"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "status": {
          "enum": [
            "verified",
            "reconciled",
            "unverified",
            "unresolved",
            "contradicted"
          ]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*(?![\\s\\S])"
          }
        },
        "caveats": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "workflow_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "claims"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*(?![\\s\\S])"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*(?![\\s\\S])"
          }
        }
      }
    },
    "clinical_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "kind",
        "scope",
        "profiles",
        "summary",
        "domains",
        "search_terms",
        "related_concepts",
        "related_tables",
        "related_relationships",
        "claims",
        "workflow_steps",
        "caveats"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "kind": {
          "enum": [
            "clinical_workflow",
            "data_representation",
            "interpretation_guardrail",
            "known_issue"
          ]
        },
        "scope": {
          "enum": [
            "general_clinical",
            "embed_general",
            "profile_specific"
          ]
        },
        "profiles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*(?![\\s\\S])"
          }
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "identity",
              "demographics",
              "social_determinants_of_health",
              "exam",
              "breast_side",
              "imaging",
              "mammography",
              "ultrasound",
              "mri",
              "pathology",
              "procedure",
              "report",
              "risk",
              "temporal",
              "workflow",
              "technical"
            ]
          }
        },
        "search_terms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "related_concepts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*(?![\\s\\S])"
          }
        },
        "related_tables": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/context_table_reference"
          }
        },
        "related_relationships": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*(?![\\s\\S])"
          }
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/context_claim"
          }
        },
        "workflow_steps": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/workflow_step"
          }
        },
        "caveats": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "scope": {
