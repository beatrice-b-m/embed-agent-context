            "$ref": "#/$defs/workflow_step"
          }
        },
        "caveats": {
          "$ref": "#/$defs/nonblank_strings"
        }
      },
      "allOf": [
        {
          "$ref": "#/$defs/profile_scope_rule"
        },
        {
          "if": {
            "properties": {
              "scope": {
                "const": "profile_specific"
              }
            },
            "required": [
              "scope"
            ]
          },
          "else": {
            "properties": {
              "related_tables": {
                "maxItems": 0
              },
              "related_relationships": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "clinical_workflow"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "workflow_steps": {
                "minItems": 2
              }
            }
          },
          "else": {
            "properties": {
              "workflow_steps": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
